extends ../layout

block content
    h3 Schedule Check for #{event.name}
    ul.nav.nav-tabs.w-100.my-2#scheduleCheckTabs(role="tablist")
        li.nav-item(role="presentation")
            a.nav-link.active#schedule-users-tab(href="#schedule-users" data-bs-toggle="tab" role="tab" aria-controls="schedule-users" aria-selected="true") By Attendee

        li.nav-item(role="presentation")
            a.nav-link#schedule-timeslot-tab(href="#schedule-timeslot" data-bs-toggle="tab" role="tab" aria-controls="schedule-timeslot" aria-selected="false") By Timeslot

    .tab-content#grantTabsContent
        .tab-pane.fade.show.active#schedule-users(role="tabpanel" aria-labelledby="schedule-users-tab")
            h4 Schedule By Attendee
            +scheduleLoadTable(users)

        .tab-pane.fade#schedule-timeslot(role="tabpanel" aria-labelledby="schedule-timeslot-tab")
            h4 Schedule Timeslot
            +loadByTimeslot(timeslots)

mixin scheduleLoadTable(users)
    .table-responsive
        .col-sm-6.offset-sm-3.text-center.table-loading
            .spinner-border.m-5(role="status" style="width: 3rem; height: 3rem;")
                .visually-hidden Table is Loading
        table.table.table-striped.data-table.my-3.dt-responsive.nowrap.table-sm.w-100.table-exportable(
            style="display: none"
            data-csrf=csrfToken
            data-export=`/event/${event.id}/schedule/check?export=attendee`
            )
            thead
                tr
                    th
                    th(data-priority="1") Name
                    th Type
                    th Busy Slots
                    th Scheduled Slots
                    th Scenes

            tbody
                each user in users
                    -
                        const slotsBusy = user.schedule.filter(timeslot => {
                            if (timeslot.scenes.length) { return true; }
                            if (timeslot.schedule_busy) { return true; }
                            return false;
                        })
                        const slotsScheduled = user.schedule.filter(timeslot => {
                            if (timeslot.scenes.length) { return true; }
                            return false;
                        })
                        const scenes = user.schedule.reduce((a, timeslot) => {
                            for (const scene of timeslot.scenes){
                                if (!_.findWhere(a, {id:scene.id})){
                                    a.push(scene);
                                }
                            }
                            return a;
                        }, [])
                    tr
                        td.dtr-control
                        td=user.name
                        td=capitalize(user.typeForDisplay)
                        td=slotsBusy.length
                        td=slotsScheduled.length
                        td=scenes.length

mixin loadByTimeslot(timeslots, players=false)
    .table-responsive
        .col-sm-6.offset-sm-3.text-center.table-loading
            .spinner-border.m-5(role="status" style="width: 3rem; height: 3rem;")
                .visually-hidden Table is Loading
        table.table.table-striped.data-table.my-3.dt-responsive.nowrap.table-sm.w-100.table-exportable(
            style="display: none"
            data-csrf=csrfToken
            data-export=`/event/${event.id}/schedule/check?export=timeslot`
            )
            thead
                tr
                    th
                    th(data-priority="1") Timeslot
                    th Scenes
                    th Players Busy
                    th Players Free
                    th Staff Busy
                    th Staff Free
            tbody
                each timeslot in timeslots
                    tr
                        td.dtr-control
                        td=timeslot.name
                        td=timeslot.scenes
                        td=timeslot.busyPlayers
                        td=timeslot.totalPlayers - timeslot.busyPlayers
                        td=timeslot.busyStaff
                        td=timeslot.totalStaff - timeslot.busyStaff

append scripts
    script(src='/javascripts/data-table.js')
    script.
        $(function(){
            const tabStorageId = 'cdb-schedule-check-tab';
            const selectedTab = localStorage.getItem(tabStorageId);
            if (selectedTab) {
                $(`#${selectedTab}`).tab('show');
            }
            $('#scheduleCheckTabs').on('shown.bs.tab', function(e){
                localStorage.setItem(tabStorageId, $(e.target).attr('id'));
            });
        });

