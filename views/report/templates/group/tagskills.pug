block content
    .card.mb-3
        h5.py-2.card-header(data-bs-toggle="collapse" href="#report-tagskills-body" aria-expanded="false") Tag Reading Skills
            span.badge.rounded-pill.text-bg-danger.mx-2=_.keys(tagskills).length
            span.float-end.ps-2
                i.fa.fa-chevron-up
                i.fa.fa-chevron-down

        ul.card-text.list-group.list-group-flush.collapse#report-tagskills-body
            if !_.keys(tagskills).length
                li.py-2.list-group-item
                    i No Tag Reading Skills
            each value, tagskill in tagskills
                li.py-2.list-group-item=tagskill
                    span.ms-1.float-end.text-small
                        if characters.length === value.length
                            i All
                        else
                            -
                                const charNames = value.map(e => {
                                    return (_.findWhere(characters, {id:e})).name
                                });
                            = charNames.join(', ')
